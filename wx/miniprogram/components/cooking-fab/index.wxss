/* 「快结束」提醒：顶部悬浮的堆叠容器，z-index 高于浮球(90) 低于抽屉(9999) */
.ck-alerts {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: calc(env(safe-area-inset-top) + 96rpx);
  z-index: 500;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 单条横幅（堆叠项） */
.ck-alert {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #FFE4C9;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(31, 27, 22, 0.18);
  animation: ck-alert-in 0.28s cubic-bezier(0.32, 1.2, 0.6, 1);
}

.ck-alert--done {
  border-color: #FF7A00;
}

.ck-alert__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ck-alert__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F1B16;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ck-alert__text {
  font-size: 24rpx;
  color: #FF7A00;
  font-weight: 500;
}

.ck-alert__btns {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.ck-alert__btn {
  font-size: 24rpx;
  color: #9B978F;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  background: #F4F5F7;
}

.ck-alert__btn--go {
  color: #FFFFFF;
  background: #FF7A00;
  font-weight: 500;
}

@keyframes ck-alert-in {
  0% { opacity: 0; transform: translateY(-16rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* 浮球：默认靠右（位置由内联 style 控制），可拖拽吸附；z-index 略低于抽屉 */
.ck-fab {
  position: fixed;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 0, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  border: 4rpx solid #FFE4C9;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  will-change: transform, left, top;
}

/* 拖拽中：放大反馈（仿 ai-fab） */
.ck-fab--dragging {
  transform: scale(1.1);
  box-shadow: 0 16rpx 40rpx rgba(255, 122, 0, 0.46);
  transition: transform 0.12s ease;
}

.ck-fab__icon {
  width: 60rpx;
  height: 60rpx;
}

.ck-fab__badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 9999rpx;
  background: #FF7A00;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 抽屉蒙层 + 抽屉：z-index 高于自定义 tabBar（100/101），对齐 ai-sheet 范式 */
.ck-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9999;
}

.ck-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  z-index: 10000;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  /* 更高的抽屉，方便查看多道在做的菜 */
  height: 78vh;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}

.ck-sheet--open {
  transform: translateY(0);
}

.ck-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E5E0D8;
  margin: 16rpx auto 8rpx;
}

.ck-sheet__head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 12rpx 32rpx 16rpx;
}

.ck-sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1B16;
}

.ck-sheet__count {
  font-size: 24rpx;
  color: #9B978F;
}

.ck-sheet__hint {
  margin-left: auto;
  font-size: 22rpx;
  color: #B8B4AC;
}

.ck-sheet__list {
  flex: 1;
}

/* 行：相对定位，溢出隐藏；删除按钮垫在内容层下方靠右 */
.ck-row {
  position: relative;
  overflow: hidden;
}

.ck-row__del {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 140rpx;
  background: #E5604A;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ck-row__main {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F4F2EE;
  transition: transform 0.2s ease;
  will-change: transform;
}

/* 跟手拖动时禁用过渡，避免橡皮筋滞后 */
.ck-row__main--drag {
  transition: none;
}

.ck-row__cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #FFEAD2 0%, #FFD6AA 100%);
  flex-shrink: 0;
}

.ck-row__cover-i {
  width: 100%;
  height: 100%;
}

.ck-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ck-row__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1B16;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ck-row__step {
  font-size: 23rpx;
  color: #FF7A00;
  font-weight: 500;
}

.ck-row__go {
  font-size: 25rpx;
  color: #9B978F;
  flex-shrink: 0;
}

.ck-sheet__safe {
  height: calc(env(safe-area-inset-bottom) + 16rpx);
}
