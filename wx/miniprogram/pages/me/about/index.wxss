.about {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF1E2 0%, #FAFAF8 320rpx);
  padding: 0 32rpx 60rpx;
}

/* ========== 品牌区 ========== */
.about__hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 36rpx;
}

.about__logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: #FFEDD9;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.about__logo-img {
  width: 128rpx;
  height: 128rpx;
}

.about__name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1F1B16;
  margin-top: 20rpx;
}

.about__en {
  font-size: 24rpx;
  color: #FF7A00;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-top: 6rpx;
}

.about__ver {
  font-size: 22rpx;
  color: #9B978F;
  margin-top: 10rpx;
}

/* ========== 通用卡片 ========== */
.about__card {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 20, 8, 0.05);
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
}

.about__sec-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1B16;
  margin-bottom: 14rpx;
}

.about__desc {
  font-size: 25rpx;
  line-height: 1.7;
  color: #6E6A62;
}

.about__feature {
  margin-top: 18rpx;
}

.about__feature-item {
  font-size: 25rpx;
  line-height: 1.6;
  color: #5C544A;
  padding: 8rpx 0;
}

/* AI 说明卡：浅橙底强调 */
.about__card--note {
  background: #FFF6EC;
  box-shadow: none;
}

/* ========== 列表卡（文档 / 联系方式） ========== */
.about__card--list {
  padding: 0 30rpx;
}

.about__row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.about__row-text {
  flex: 1;
  font-size: 28rpx;
  color: #1F1B16;
}

.about__row-value {
  font-size: 25rpx;
  color: #9B978F;
}

.about__row-arrow {
  width: 28rpx;
  height: 28rpx;
}

.about__row-divider {
  height: 2rpx;
  background: #F4F2EE;
  transform: scaleY(0.5);
}

/* ========== 版权 ========== */
.about__copyright {
  text-align: center;
  font-size: 21rpx;
  color: #B6B2AA;
  margin-top: 12rpx;
}

.about__spacer { height: 40rpx; }
