<view class="fbs">
  <custom-navbar title="意见反馈"></custom-navbar>

  <!-- 反馈类型 -->
  <view class="fbs__sec">
    <view class="fbs__label">反馈类型</view>
    <view class="fbs__chips">
      <view
        wx:for="{{categories}}"
        wx:key="value"
        class="fbs__chip {{category === item.value ? 'fbs__chip--on' : ''}}"
        data-value="{{item.value}}"
        bindtap="onCategoryTap"
      >{{item.label}}</view>
    </view>
  </view>

  <!-- 反馈内容 -->
  <view class="fbs__sec">
    <view class="fbs__label">反馈内容</view>
    <view class="fbs__textarea-wrap">
      <textarea
        class="fbs__textarea"
        placeholder="请描述你遇到的问题或建议，越详细越好～"
        value="{{content}}"
        maxlength="{{maxContent}}"
        bindinput="onContentInput"
        auto-height
      />
      <view class="fbs__counter">{{contentLen}}/{{maxContent}}</view>
    </view>
  </view>

  <!-- 截图 -->
  <view class="fbs__sec">
    <view class="fbs__label">截图（选填，最多 {{maxImages}} 张）</view>
    <view class="fbs__imgs">
      <view class="fbs__img" wx:for="{{images}}" wx:key="key">
        <image class="fbs__img-pic" src="{{item.url || item.localPath}}" mode="aspectFill" />
        <view wx:if="{{item.uploading}}" class="fbs__img-mask">上传中</view>
        <view class="fbs__img-del" data-key="{{item.key}}" catchtap="onRemoveImage">×</view>
      </view>
      <view wx:if="{{images.length < maxImages}}" class="fbs__img-add" bindtap="onAddImage">
        <view class="fbs__img-add-plus">＋</view>
      </view>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="fbs__sec">
    <view class="fbs__label">联系方式（选填）</view>
    <input
      class="fbs__input"
      placeholder="微信号 / 手机号 / 邮箱，方便我们回复你"
      value="{{contact}}"
      bindinput="onContactInput"
      type="text"
    />
  </view>

  <view class="fbs__spacer"></view>

  <!-- 提交 -->
  <view class="fbs__submit-bar">
    <view
      class="fbs__submit-btn {{(content && !submitting) ? '' : 'fbs__submit-btn--disabled'}}"
      bindtap="onSubmit"
    >{{submitting ? '提交中…' : '提交反馈'}}</view>
  </view>
</view>
