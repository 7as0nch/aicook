.fbs {
  min-height: 100vh;
  background: #FAFAF8;
  padding: 0 32rpx 200rpx;
}

.fbs__sec {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 20, 8, 0.04);
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
}

.fbs__label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F1B16;
  margin-bottom: 18rpx;
}

/* ========== 类型 chip ========== */
.fbs__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.fbs__chip {
  font-size: 25rpx;
  color: #6E6A62;
  background: #F4F2EE;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
  border: 2rpx solid transparent;
}

.fbs__chip--on {
  color: #FF7A00;
  background: #FFF1E2;
  border-color: #FF7A00;
  font-weight: 600;
}

/* ========== 文本域 ========== */
.fbs__textarea-wrap {
  position: relative;
}

.fbs__textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #1F1B16;
}

.fbs__counter {
  text-align: right;
  font-size: 22rpx;
  color: #B6B2AA;
  margin-top: 10rpx;
}

/* ========== 截图 ========== */
.fbs__imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.fbs__img {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F4F2EE;
}

.fbs__img-pic {
  width: 100%;
  height: 100%;
}

.fbs__img-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 22rpx;
}

.fbs__img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 1;
  border-bottom-left-radius: 16rpx;
}

.fbs__img-add {
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #D8D4CC;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FBFAF8;
}

.fbs__img-add-plus {
  font-size: 56rpx;
  color: #C7C2B8;
  line-height: 1;
}

/* ========== 联系方式 ========== */
.fbs__input {
  width: 100%;
  font-size: 27rpx;
  color: #1F1B16;
  padding: 6rpx 0;
}

.fbs__spacer {
  height: 20rpx;
}

/* ========== 提交栏 ========== */
.fbs__submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -6rpx 20rpx rgba(31, 20, 8, 0.05);
}

.fbs__submit-btn {
  height: 92rpx;
  border-radius: 999rpx;
  background: #FF7A00;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fbs__submit-btn--disabled {
  background: #F0C9A3;
}
