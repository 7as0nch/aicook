.plan {
  min-height: 100vh;
  background: #FAFAF8;
  padding: 0 48rpx 220rpx;
}

.plan__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 0 28rpx;
}

.plan__head-titles {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.plan__title {
  font-size: 46rpx;
  font-weight: 700;
  color: #1F1B16;
  line-height: 1.1;
}

.plan__subtitle {
  font-size: 25rpx;
  color: #9B978F;
}

.plan__cart-btn {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #FFF6EE;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan__cart-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 采购清单数量徽标（采购卡已移除，入口只剩这个右上角购物车） */
.plan__cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 9999rpx;
  background: #FF7A00;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.plan__week-card {
  background: #FFFFFF;
  border: 2rpx solid #EFEDE8;
  border-radius: 36rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(31, 20, 8, 0.05);
}

.plan__week-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.plan__week-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1F1B16;
}

.plan__week-range {
  font-size: 23rpx;
  color: #9B978F;
}

.plan__week-days {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
}

.plan__day {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 6rpx 0;
  gap: 8rpx;
}

.plan__day-name {
  font-size: 21rpx;
  color: #9B978F;
  line-height: 1;
}

.plan__day-num {
  width: 60rpx;
  height: 48rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #1F1B16;
}

.plan__day--active .plan__day-name {
  color: #EF6E00;
}

.plan__day--active .plan__day-num {
  background: #FF7A00;
  color: #FFFFFF;
  font-weight: 600;
}

.plan__meal-card {
  background: #FFFFFF;
  border: 2rpx solid #EFEDE8;
  border-radius: 36rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(31, 20, 8, 0.05);
}

.plan__meal-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.plan__meal-emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  background: #FFF6EE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.plan__meal-titles {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.plan__meal-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1B16;
  line-height: 1.1;
}

.plan__meal-time {
  font-size: 23rpx;
  color: #9B978F;
}

.plan__meal-add {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFF6EE;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan__meal-add-icon {
  width: 36rpx;
  height: 36rpx;
}

.plan__meal-divider {
  height: 2rpx;
  background: #EFEDE8;
  margin: 20rpx -28rpx 20rpx;
}

/* 菜品流式展示：默认收起只显一行，多了点「展开全部」铺开 */
.plan__dishes {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.plan__dishes--collapsed {
  max-height: 60rpx; /* 一行 chip 高度，第二行被裁掉 */
  overflow: hidden;
}

.plan__chip {
  max-width: 100%;
  padding: 12rpx 26rpx;
  background: #FFF6EE;
  color: #5C3A12;
  border-radius: 9999rpx;
  font-size: 26rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plan__dish-toggle {
  margin-top: 14rpx;
  text-align: center;
  font-size: 23rpx;
  color: #FF7A00;
}

.plan__empty-tip {
  text-align: center;
  color: #9B978F;
  font-size: 23rpx;
  padding: 18rpx 0 4rpx;
}

.plan__ai-btn {
  background: linear-gradient(135deg, #FFB366 0%, #FF7A00 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 0, 0.32);
}

.plan__spacer { height: 80rpx; }
